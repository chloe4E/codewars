{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "mvn checkstyle:check -q",
            "statusMessage": "Running Checkstyle...",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // empty'); [[ \"$file\" == *.java ]] && mvn checkstyle:check -q || true",
            "statusMessage": "Running Checkstyle...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
