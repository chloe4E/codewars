{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "mvn checkstyle:check -q",
            "statusMessage": "Running Checkstyle...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
